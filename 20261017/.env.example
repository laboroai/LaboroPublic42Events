# 当日は運営が配布する。キーをリポジトリにコミットしない
OPENAI_API_KEY=
# エージェントが使うモデル（OpenAIのモデルID）
HANDSON_MODEL=gpt-5.6-terra
# QA検索に使う埋め込みモデル
HANDSON_EMBED_MODEL=text-embedding-3-small
# APIの呼び先。openai（既定）か bedrock。bedrock にするときは HANDSON_MODEL と HANDSON_EMBED_MODEL の行を消し、
# AWS_BEARER_TOKEN_BEDROCK と AWS_REGION=ap-northeast-1 を書く
HANDSON_PROVIDER=openai
# 1にするとAPIを呼ばずに動く（動作確認用）
HANDSON_MOCK=0
